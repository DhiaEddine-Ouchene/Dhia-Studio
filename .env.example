# Server Port Configuration
PORT=3000

# SMTP Mail Server Credentials (Option 1)
# (e.g., for Gmail use smtp.gmail.com with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-or-token

# Target Email where form submissions will be delivered
RECIPIENT_EMAIL=dhiastudio.agency@gmail.com

# Web3Forms Access Key (Option 2 - Free & Passwordless Email Delivery)
# Get a free key instantly by entering your email at: https://web3forms.com
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here

